PORT=5000
MONGO_URI=mongodb://localhost:27017/placemate
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRE=7d

# Cloudinary (resume uploads) - get these from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (status/approval notifications) - Gmail example, use an App Password not your real password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=PlaceMate <no-reply@placemate.com>

# Set to your deployed frontend URL in production (used for CORS + email links)
CLIENT_URL=http://localhost:5173
